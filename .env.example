# ─── Server ───
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ───
# Get your free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fileguard

# ─── OriginStamp Blockchain Timestamping ───
# Free tier: 50 timestamps/month — https://originstamp.com
# Leave empty to use deterministic mock (development mode)
ORIGINSTAMP_API_KEY=

# ─── CORS ───
CORS_ORIGIN=http://localhost:5173
